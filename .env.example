# Скопируйте в server/.env (или корневой .env — значения подставятся в docker-compose.yml)

# --- Порт API ---
PORT=4000

# --- База данных (PostgreSQL) ---
DATABASE_URL="postgresql://ecomm:CHANGE_ME@localhost:5432/ecommderce?schema=public"

# Для Docker Compose: пароль БД переопределяется из root-переменной POSTGRES_PASSWORD.
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Платежи ---
# mock — имитация оплаты для разработки; stripe — реальная интеграция (test mode).
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_CURRENCY="rub"

# Тестовая карта Stripe (test mode): 4242 4242 4242 4242
# Для PAYMENTS_PROVIDER=stripe настройте вебхук checkout.session.completed.

# --- CORS ---
# Источник фронтенда (через nginx в проде — http://localhost или ваш домен).
CLIENT_ORIGIN="http://localhost:5173"

# --- Email (SMTP) ---
# Для Gmail: в настройках Google включите 2FA и создайте «Пароль приложений»,
# его и используйте в SMTP_PASS (обычный пароль Gmail не подходит).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="redpendalff@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Умная Корзина <redpendalff@gmail.com>"
# Без заполненного SMTP_PASS почта не отправляется — ссылка логируется в консоль.

# --- Docker Compose ---
# Порт публикации основного nginx (по умолчанию 80).
# HTTP_PORT=80