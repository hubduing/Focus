# Сервер
PORT=4000
DATABASE_URL="postgresql://ecomm:ecomm_dev_password@localhost:5432/ecommderce?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="dev-jwt-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Восстановление пароля (test-режим: ссылка логируется в консоль)
RESET_TOKEN_TTL_MINUTES=60
API_PUBLIC_URL="http://localhost:4000"

# Платёжный провайдер (тест-режим):
#   mock  — локальная разработка и E2E без реального Stripe (мгновенная оплата)
#   stripe — Stripe test mode: требуется STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
PAYMENTS_PROVIDER=mock

# Stripe (test mode) — нужны только при PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_CURRENCY="rub"

# CORS
CLIENT_ORIGIN="http://localhost:5173"